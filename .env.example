APP_NAME=GGHI-EmployeeTrack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meditrack: dates and reminder schedule follow this timezone
APP_TIMEZONE=Asia/Manila

# UniSMS SMS reminders (https://unismsapi.com). Leave the key empty to log SMS instead of sending.
UNISMS_SECRET_KEY=
UNISMS_SENDER_ID=

# Meditrack schedule (defaults shown)
# ANNUAL_CHECK_INTERVAL_MONTHS=12
# ANNUAL_CHECK_REMINDER_DAYS=30
# REMINDER_DAYS_BEFORE=3
# REMINDER_OVERDUE_REPEAT_DAYS=7
# REMINDER_SEND_AT=07:00
# REMINDER_HR_DIGEST_DAY=monday

# Clinic appointments (defaults shown). Days are a comma-separated list.
# CLINIC_DAYS=monday,tuesday,wednesday,thursday,friday,saturday,sunday
# CLINIC_OPENS_AT=08:00
# CLINIC_CLOSES_AT=17:00
# CLINIC_BREAK_STARTS_AT=12:00
# CLINIC_BREAK_ENDS_AT=13:00
# CLINIC_SLOT_MINUTES=30
# CLINIC_PATIENTS_PER_SLOT=1
# CLINIC_BOOKING_WINDOW_DAYS=60

# Branding: sidebar tagline and the office line shown in the sidebar and on printed records
# BRAND_TAGLINE="Employee Health Records"
# BRAND_OFFICE="GSAC General Hospital Inc."
# BRAND_LOGO=/images/gsac-logo.png
# BRAND_MARK=/images/gsac-mark.png
# BRAND_OFFICE_ADDRESS=

# AI assistance (Claude). Off until a key is set and AI_ENABLED=true.
AI_ENABLED=false
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
